  "services": {
    "start_plan": {
      "name": "Start plan",
      "description": "Starts one of the robot's plans, the way the Yarbo app does.",
      "fields": {
        "config_entry_id": {
          "name": "Robot",
          "description": "Only needed with more than one robot."
        },
        "plan": {
          "name": "Plan name",
          "description": "The plan's name as the robot has it."
        },
        "plan_id": {
          "name": "Plan id",
          "description": "Instead of the name."
        }
      }
    },
    "set_lights": {
      "name": "Set lights",
      "description": "Sets all seven light channels at once (0 to 255). Takes the robot's controller, so it is refused during a plan.",
      "fields": {
        "config_entry_id": {
          "name": "Robot",
          "description": "Only needed with more than one robot."
        },
        "brightness": {
          "name": "Brightness",
          "description": "For every channel not given below."
        },
        "led_head": {
          "name": "Head",
          "description": "Head light."
        },
        "led_left_w": {
          "name": "Left white",
          "description": "Left white light."
        },
        "led_right_w": {
          "name": "Right white",
          "description": "Right white light."
        },
        "body_left_r": {
          "name": "Body left",
          "description": "Body light, left."
        },
        "body_right_r": {
          "name": "Body right",
          "description": "Body light, right."
        },
        "tail_left_r": {
          "name": "Tail left",
          "description": "Tail light, left."
        },
        "tail_right_r": {
          "name": "Tail right",
          "description": "Tail light, right."
        }
      }
    },
    "get_map": {
      "name": "Get map",
      "description": "Returns the robot's map as GeoJSON (WGS84) with its revision.",
      "fields": {
        "config_entry_id": {
          "name": "Robot",
          "description": "Only needed with more than one robot."
        }
      }
    }
  }
