{
  "config": {
    "flow_title": "Yarbo {serial}",
    "step": {
      "user": {
        "title": "Add a Yarbo",
        "description": "Enter the robot's address, or leave it empty to scan the network for it.",
        "data": {
          "host": "Address",
          "scan": "Network to scan"
        },
        "data_description": {
          "host": "IP address or name of the robot (or its base station). Empty: scan.",
          "scan": "Optional, e.g. 192.168.1.0/24. Default: the networks Home Assistant is on."
        }
      },
      "pick": {
        "title": "Choose a robot",
        "description": "More than one Yarbo answered.",
        "data": {
          "serial": "Robot"
        }
      },
      "confirm": {
        "title": "Add Yarbo {serial}?",
        "description": "Found at {host}."
      }
    },
    "error": {
      "cannot_connect": "No Yarbo answered at that address on port 1883.",
      "no_network": "Home Assistant is on no private network to scan. Enter the robot's address or a network.",
      "not_found": "No Yarbo was found. Check it is awake and on the same network, or enter its address."
    },
    "abort": {
      "already_configured": "This robot is already set up.",
      "not_a_robot": "That device is not a Yarbo."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "yarbie options",
        "data": {
          "allow_writes": "Allow map, plan and settings writes",
          "observe_only": "Observe only (send the robot nothing)",
          "keep_awake": "Keep the robot awake",
          "scan": "Network to scan if the robot moves",
          "google_maps_key": "Google Maps key (satellite imagery in the Yard editor)",
          "run_retention_days": "Keep run records for (days)"
        },
        "data_description": {
          "observe_only": "For running beside another integration: reads only, never takes the robot's controller.",
          "keep_awake": "Sends the wake command every minute. It takes the controller."
        }
      }
    }
  },
  "issues": {
    "untested_firmware": {
      "title": "Yarbo firmware {firmware} not yet tested",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Turn writes on for firmware {firmware}?",
            "description": "yarbie's command list was verified on another firmware. Map, plan and settings writes are off until you confirm; controls still work.\n\nBefore confirming: draw a small no-go zone in the Yard editor, send it, and check the Yarbo app shows it and can edit and delete it."
          }
        }
      }
    }
  },
