# Where the map comes from: sim (built-in simulator), lan (robot on your network), cloud (read-only)
YARBIE_SOURCE=sim

# lan: leave YARBO_HOST empty to find the robot automatically (the address found is
# remembered in data/lan_robot.json). Set YARBO_SERIAL if there is more than one robot.
YARBO_HOST=
YARBO_SERIAL=
# Networks to search, e.g. 192.168.1.0/24 (default: this machine's /24). Needed in Docker.
YARBIE_SCAN=

# cloud: Yarbo account (read-only map view)
YARBO_EMAIL=
YARBO_PASSWORD=

# Optional: Google satellite imagery (Map Tiles API enabled, billing on the project).
GOOGLE_MAPS_API_KEY=

# Where backups and the cloud token cache are written
YARBIE_DATA_DIR=data
